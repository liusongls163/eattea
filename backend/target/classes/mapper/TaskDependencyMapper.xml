<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eattea.mapper.TaskDependencyMapper">

    <select id="selectByTaskId" resultType="com.eattea.entity.TaskDependency">
        SELECT * FROM pm_task_dependency WHERE task_id = #{taskId}
    </select>

    <select id="selectByDependsOn" resultType="com.eattea.entity.TaskDependency">
        SELECT * FROM pm_task_dependency WHERE depends_on_id = #{dependsOnId}
    </select>

    <select id="selectByProject" resultType="com.eattea.entity.TaskDependency">
        SELECT d.* FROM pm_task_dependency d
        INNER JOIN pm_task t ON d.task_id = t.id
        WHERE t.project_id = #{projectId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pm_task_dependency (task_id, depends_on_id) VALUES (#{taskId}, #{dependsOnId})
    </insert>

    <delete id="deleteById">
        DELETE FROM pm_task_dependency WHERE id = #{id}
    </delete>

    <delete id="deleteByTaskId">
        DELETE FROM pm_task_dependency WHERE task_id = #{taskId}
    </delete>

</mapper>
